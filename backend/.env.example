# ==============================================================================
# Markdown Intelligence Console - Environment Configuration
# ==============================================================================

APP_ENV=development
APP_NAME="Markdown Intelligence Console"
API_V1_PREFIX=/api/v1
DEBUG=True

# Database Configuration (PostgreSQL with psycopg3 driver)
# Do not commit real production passwords to version control
DATABASE_URL=postgresql+psycopg://markdown_app:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/markdown_optimization

# Explicit Test Database URL (Used exclusively for automated unit test runs)
# TEST_DATABASE_URL=sqlite:///./test_markdown_optimization.db

# JWT Authentication
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_64_CHAR_HEX_RANDOM_SECRET_KEY_FOR_LOCAL_DEV
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Local File and Artifact Paths (Relative to backend root)
ML_ARTIFACT_ROOT=../ml/artifacts
DATA_ROOT=../data
REPORT_ROOT=../data/reports/optimizer/runs
